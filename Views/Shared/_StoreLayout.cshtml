<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - SportStore</title>

    @Styles.Render("~/Content/css")
    <link href="@Url.Content("~/Content/sportstore.css")" rel="stylesheet" />
</head>
<body>
    <header class="store-header">
        <div class="container">
            <a href="@Url.Action("Index", "Store")" class="store-logo">
                SportStore
            </a>
            <p>Cửa hàng thể thao dành cho bạn</p>
        </div>
    </header>

    <nav class="store-nav">
        <div class="container">
            <a href="@Url.Action("Index", "Store")">Trang chủ</a>
            @Html.ActionLink("Giới thiệu", "AboutStore", "Store")
            <a href="#">Sản phẩm</a>
            <a href="#">Danh mục</a>
            <a href="#">Liên hệ</a>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer class="store-footer">
        <div class="container">
            <p>© 2026 SportStore - Cửa hàng thể thao</p>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>