@model DBSportStore.Models.Product

@{
    ViewBag.Title = "Chi tiết sản phẩm";
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
}

<div class="container" style="margin-top:30px; margin-bottom:40px;">
    <h2>Chi tiết sản phẩm</h2>
    <hr />

    <div class="row">
        <div class="col-md-5">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Url.Content("~/Content/Images/" + Model.ImageUrl)"
                     alt="@Model.ProductName"
                     style="width:100%; max-width:400px; height:350px; object-fit:contain; border:1px solid #ddd; border-radius:10px; padding:10px;" />
            }
            else
            {
                <p>Chưa có hình ảnh sản phẩm.</p>
            }
        </div>

        <div class="col-md-7">
            <h3>@Model.ProductName</h3>

            <table class="table">
                <tr>
                    <th style="width:180px;">Mã sản phẩm</th>
                    <td>@Model.ProductID</td>
                </tr>
                <tr>
                    <th>Tên sản phẩm</th>
                    <td>@Model.ProductName</td>
                </tr>
                <tr>
                    <th>Mô tả</th>
                    <td>@Model.Description</td>
                </tr>
                <tr>
                    <th>Giá bán</th>
                    <td style="color:#e91e63; font-weight:bold;">
                        @Model.Price.ToString("#,##0") đ
                    </td>
                </tr>
                <tr>
                    <th>Số lượng tồn kho</th>
                    <td>@Model.StockQuantity</td>
                </tr>
                <tr>
                    <th>Trạng thái</th>
                    <td>
                        @if (Model.IsActive)
                        {
                            <span class="label label-success">Đang kinh doanh</span>
                        }
                        else
                        {
                            <span class="label label-default">Ngừng kinh doanh</span>
                        }
                    </td>
                </tr>
                <tr>
                    <th>Danh mục</th>
                    <td>
                        @(Model.Category != null
                            ? Model.Category.CategoryName
                            : "Chưa phân loại")
                    </td>
                </tr>
            </table>

            <p>
                @Html.ActionLink(
                         "Sửa sản phẩm",
                         "Edit",
                         new { id = Model.ProductID },
                         new { @class = "btn btn-primary" })

                @Html.ActionLink(
                         "Quay lại danh sách",
                         "Index",
                         null,
                         new { @class = "btn btn-default" })
            </p>
        </div>
    </div>
</div>