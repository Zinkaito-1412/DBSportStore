@model IEnumerable<DBSportStore.Models.Product>

@{
    ViewBag.Title = "Danh sách sản phẩm";
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
}

<h2>Danh sách sản phẩm</h2>

<p>
    @Html.ActionLink("Thêm sản phẩm mới", "Create")
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Tên sản phẩm</th>
            <th>Mô tả</th>
            <th>Giá</th>
            <th>Hình ảnh</th>
            <th>Số lượng tồn</th>
            <th>Trạng thái</th>
            <th>Danh mục</th>
            <th>Thao tác</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ProductName</td>
                <td>@item.Description</td>
                <td>@item.Price.ToString("N0") VNĐ</td>
                <td>
                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                    {
                        <img src="@Url.Content("~/Content/Images/" + System.IO.Path.GetFileName(item.ImageUrl))"
                             alt="@item.ProductName"
                             style="width:80px;height:80px;object-fit:contain;" />
                    }
                    else
                    {
                        <span>Chưa có ảnh</span>
                    }
                </td>
                <td>@item.StockQuantity</td>
                <td>@(item.IsActive ? "Đang bán" : "Ngừng bán")</td>
                <td>@(item.Category != null ? item.Category.CategoryName : "")</td>
                <td>
                    @Html.ActionLink("Sửa", "Edit", new { id = item.ProductID }) |
                    @Html.ActionLink("Chi tiết", "Details", new { id = item.ProductID }) |
                    @Html.ActionLink("Xóa", "Delete", new { id = item.ProductID })
                </td>
            </tr>
        }
    </tbody>
</table>