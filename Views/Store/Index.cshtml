@model IEnumerable<DBSportStore.Models.ProductCardViewModel>

@{
    ViewBag.Title = "Trang chủ";
    Layout = "~/Views/Shared/_StoreLayout.cshtml";

    var categories = ViewBag.Categories
        as IEnumerable<DBSportStore.Models.Category>;

    int? selectedCategoryId = ViewBag.SelectedCategoryId;
}

<div class="container">
    <section class="hero">
        <h1>SportStore</h1>
        <p>Khám phá trang phục, giày và dụng cụ thể thao dành cho bạn.</p>
        <a href="#products" class="btn-store">Khám phá sản phẩm</a>
    </section>

    <div class="store-sidebar">
        <h3>Danh mục sản phẩm</h3>

        <ul>
            <li>
                <a href="@Url.Action("Index", "Store")">
                    Tất cả sản phẩm
                </a>
            </li>

            @if (categories != null)
            {
                foreach (var category in categories)
                {
                    <li>
                        <a href="@Url.Action("Index", "Store",
                            new { categoryId = category.CategoryID })">
                            @category.CategoryName
                        </a>
                    </li>
                }
            }
        </ul>
    </div>

    <h2 id="products">
        @(selectedCategoryId.HasValue
            ? "Sản phẩm theo danh mục"
            : "Sản phẩm nổi bật")
    </h2>

    <div class="product-grid">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <div class="product-card">
                    <img src="@Url.Content("~/Content/Images/" + item.ImagePro)"
                         alt="@item.NamePro" />

                    <p>@item.CategoryName</p>
                    <h3 class="product-name">@item.NamePro</h3>
                    <p class="product-description">@item.ShortDescription</p>

                    <p class="product-price">
                        @item.Price.ToString("#,##0") đ
                    </p>

                    @Html.ActionLink(
                             "Xem chi tiết",
                             "Details",
                             "Products",
                             new { id = item.ProductID },
                             new { @class = "btn-store" })
                </div>
            }
        }
        else
        {
            <p>Danh mục này hiện chưa có sản phẩm.</p>
        }
    </div>
</div>